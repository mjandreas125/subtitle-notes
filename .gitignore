# Signing material and anything else that must never leave this machine.
mobile/android/key.properties
# Worker secrets for `wrangler dev`. The real ones live in Cloudflare; this
# file is whatever a developer needs locally, and it is not the repository's
# business either way.
cloud_api/.dev.vars
*.jks
*.keystore

# Built things. The installer and the Android package are attached to a
# release instead, so the repository stays a repository.
dist/
build/
mobile/build/
mobile/.dart_tool/
mobile/android/.gradle/
release_package/*.exe
release_package/*.zip
release_package/*.aab
release_package/*.apk
# The promo films: 10 MB each, rebuilt from release_package/promo by
# `node tools/build-promo.mjs film`, and they live on YouTube once uploaded.
# The store screenshots beside them are small and stay tracked.
release_package/promo/*.mp4
release_package/dist/
cloud_api/.wrangler/
cloud_api/node_modules/
node_modules/

# Screenshots the CDP driver writes while a check runs. Neither the bench nor
# the promo pages read any of them back.
tools/*.png

# Local runtime and scratch.
__pycache__/
*.pyc
*.log
.venv/
.venv312/
tmp_*
TranslatedVLC-*.zip
release_package/play/
*.spec
.wrangler/

# Renders from other tools, dropped into the promo folder. Twenty-three
# gigabytes of frames and encodes: a repository is not a scratch disk, and
# `git add -A` in here will otherwise sit there indexing them.
release_package/promo/astra/
release_package/promo/astra-v2/
