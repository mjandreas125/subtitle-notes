<?xml version="1.0" encoding="utf-8"?>
<!-- Padding is 18/18/22 rather than a uniform box: the lip already adds 4dp of
     visual weight at the bottom, so equal padding would read as bottom-heavy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="16dp"
    android:paddingRight="18dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ImageView, not View: RemoteViews refuses to inflate a bare
             android.view.View in the launcher process. -->
        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/widget_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:textColor="@color/brand_ink3"
            android:textFontWeight="800"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:textColor="@color/brand_ink"
        android:textFontWeight="900"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="2"
        android:textColor="@color/brand_ink2"
        android:textFontWeight="600"
        android:textSize="14sp" />
</LinearLayout>
