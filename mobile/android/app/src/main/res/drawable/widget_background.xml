<?xml version="1.0" encoding="utf-8"?>
<!-- The same card the app uses: a flat face standing on a solid lip, rather
     than a translucent panel with a glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_lip" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_surface" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="@color/brand_line" />
        </shape>
    </item>
</layer-list>
