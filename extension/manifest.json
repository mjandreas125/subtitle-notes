{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.6.14",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://app.subtitlenotes.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://bank.ee/*",
        "*://*.bank.ee/*"
      ],
      "js": [
        "settings.js",
        "capture.js",
        "subtitles.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
