{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index.ts",
  // The product is one host. The Worker already serves the site, the library,
  // the link page and the API from this one script, so a separate `app.`
  // subdomain would only be a second name for the same thing.
  "routes": [
    { "pattern": "subtitlenotes.com", "custom_domain": true },
    { "pattern": "www.subtitlenotes.com", "custom_domain": true }
  ],
  // Kept on, deliberately: the extension in the store, the phone app and the
  // installed program were all built pointing at the workers.dev address.
  // Turning it off retires them, not the address.
  "workers_dev": true,
  "compatibility_date": "2026-08-11",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subtitle-notes-production",
      "database_id": "b90dfac0-72ae-411d-8d5e-fa4cb5171a0d",
      "migrations_dir": "migrations"
    }
  ]
}
